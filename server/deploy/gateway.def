Bootstrap: docker
From: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

# callpc voice gateway image. CUDA-12 base ON PURPOSE: onnxruntime-gpu is a
# CUDA-12 build, so on this base its CUDA EP loads with no LD_LIBRARY_PATH
# juggling (unlike the CUDA-13 vLLM image — see PLAN/memory). Bakes in Pipecat
# (WebRTC + Silero VAD), the ASR runtime, and FastAPI/uvicorn so the gateway
# runs the Nemotron STT in-process on the GPU.
#
# Built once by deploy/build_images.sbatch (compute node).

%post
    # Install pipecat etc FIRST. pipecat[silero] depends on CPU `onnxruntime`,
    # which shares the import name with onnxruntime-gpu and clobbers it (build #1
    # ended up CPU-only). So install it now, then force the GPU build to win.
    pip install --no-cache-dir \
        "pipecat-ai[webrtc,silero,openai]" \
        pipecat-ai-small-webrtc-prebuilt \
        openai \
        sentencepiece soundfile numpy msgpack \
        fastapi "uvicorn[standard]"
    # pipecat[webrtc] pulls full opencv-python, which needs X11 libs (libxcb.so.1
    # etc.) absent in the slim base -> ImportError. Swap to headless for a server.
    pip uninstall -y opencv-python opencv-python-headless || true
    pip install --no-cache-dir opencv-python-headless
    # Make onnxruntime-gpu the sole/final onnxruntime (else ASR runs on CPU).
    pip uninstall -y onnxruntime onnxruntime-gpu || true
    pip install --no-cache-dir onnxruntime-gpu
    # CUDA-12 runtime libs for onnxruntime-gpu's CUDA EP (cublasLt/cudnn/etc).
    pip install --no-cache-dir \
        nvidia-cuda-runtime-cu12 nvidia-cublas-cu12 nvidia-cudnn-cu12 \
        nvidia-cufft-cu12 nvidia-curand-cu12 nvidia-cusparse-cu12 \
        nvidia-cuda-nvrtc-cu12 nvidia-nvjitlink-cu12
    # Pipecat needs NLTK 'punkt_tab' for sentence splitting; the runtime fs is
    # read-only, so bake it into the image and point NLTK_DATA at it.
    python -c "import nltk; nltk.download('punkt_tab', download_dir='/opt/nltk_data')"

%environment
    export TORCHDYNAMO_DISABLE=1
    export NLTK_DATA=/opt/nltk_data
    # Put the pip-installed CUDA-12 libs on the path so onnxruntime-gpu loads them.
    export LD_LIBRARY_PATH="$(ls -d /opt/conda/lib/python*/site-packages/nvidia/*/lib 2>/dev/null | tr '\n' ':')/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}"

%test
    # Import EVERY pipecat module app.py uses (catches import-path/missing-lib
    # issues at build, not at call time), and assert onnxruntime-gpu won (CUDA EP).
    python <<'PY'
import pipecat, fastapi, cv2, sentencepiece, soundfile, numpy
import onnxruntime as ort
from pipecat.audio.vad.silero import SileroVADAnalyzer
from pipecat.pipeline.pipeline import Pipeline
from pipecat.pipeline.runner import PipelineRunner
from pipecat.pipeline.task import PipelineParams, PipelineTask
from pipecat.processors.frame_processor import FrameDirection, FrameProcessor
from pipecat.transports.base_transport import TransportParams
from pipecat.transports.smallwebrtc.connection import SmallWebRTCConnection
from pipecat.transports.smallwebrtc.transport import SmallWebRTCTransport
from pipecat.services.stt_service import STTService
from pipecat.services.openai.llm import OpenAILLMService
from pipecat.processors.aggregators.llm_context import LLMContext
from pipecat.processors.aggregators.llm_response_universal import LLMContextAggregatorPair
from pipecat.frames.frames import TranscriptionFrame, InterimTranscriptionFrame, TextFrame, LLMFullResponseEndFrame
# exercise the context aggregator pair (validates .user()/.assistant() at build)
_p = LLMContextAggregatorPair(LLMContext(messages=[{"role": "system", "content": "x"}]))
_p.user(); _p.assistant()
provs = ort.get_available_providers()
print("providers", provs)
assert "CUDAExecutionProvider" in provs, "onnxruntime-gpu NOT installed (CPU build won)"
print("gateway image imports OK + CUDA EP present")
PY

%runscript
    # `apptainer run gateway.sif <script.py> [args]` -> python <script.py> [args]
    exec python "$@"
